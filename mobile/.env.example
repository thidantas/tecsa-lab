# Web / simulador iOS: localhost funciona.
# Android (Expo Go ou emulador): deixe vazio ou localhost —
# o app troca sozinho pelo IP do Metro ou 10.0.2.2.
# Celular físico, se falhar: use o IP da máquina, ex. http://192.168.0.10:9000
EXPO_PUBLIC_API_URL=http://localhost:9000

# Backend injetado nos repositories. `tecsaNest` | `inMemory`
EXPO_PUBLIC_API_PROFILE=tecsaNest

# Default da marca neste binário (CI/CD troca no deploy). Override em runtime via store.
EXPO_PUBLIC_BRAND=vita
