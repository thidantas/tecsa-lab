# Web / simulador iOS: localhost funciona.
# Android (Expo Go ou emulador): deixe vazio ou localhost —
# o app troca sozinho pelo IP do Metro ou 10.0.2.2.
# Celular físico, se falhar: use o IP da máquina, ex. http://192.168.0.10:9000
EXPO_PUBLIC_API_URL=http://localhost:9000

# Backend injetado nos repositories. `hybrid` (default) | `tecsaNest` | `inMemory`
# No hybrid, a geração de IA usa fixture local (sem token). Nest real: perfil `tecsaNest`.
EXPO_PUBLIC_API_PROFILE=hybrid

# Marca deste binário. Define splash nativo no start/build e o tema default.
# `vita` | `nexo`. Trocar exige restart do Expo (splash é de build).
EXPO_PUBLIC_BRAND=vita
