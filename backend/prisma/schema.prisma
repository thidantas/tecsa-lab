generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id          String      @id @default(uuid())
  name        String
  birthDate   DateTime    @db.Date
  sex         String?
  notes       String?
  createdAt   DateTime    @default(now())
  biomarkers  Biomarker[]
}

model Biomarker {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name       String
  value      Float
  unit       String
  measuredAt DateTime
  refLow     Float?
  refHigh    Float?

  @@index([patientId])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}
